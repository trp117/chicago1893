# Normalize line endings. The engine writes content files with LF (boot-restore
# from Supabase), while core.autocrlf=true made Git expect CRLF in the working
# tree -- that mismatch marked ~162 unchanged files as modified on every boot.
# Declaring eol=lf makes the working tree match what the engine writes.

# Default: detect text, store LF in the repo, check out LF.
* text=auto eol=lf

# Content and source -- always LF.
*.json text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.toml text eol=lf

# Binary -- never convert.
*.jpg binary
