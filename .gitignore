node_modules/
.env
*.log
.DS_Store
data/sessions/
engine/data/transcripts/
images/sources/
engine/data/scenarios.backup/
.claude/settings.local.json
# --- Supabase-owned content -------------------------------------------------
# Source of truth is Supabase (scenario_data + scenarios tables); the engine
# rewrites these on boot via restoreFromSupabase, which churned updatedAt on
# ~244 files every session. File globs (not directory excludes) so the
# exceptions below can still be re-included.
engine/data/characters/*.json
engine/data/clues/**/*.json
engine/data/locations/**/*.json
engine/data/story_arcs/*.json
engine/data/scenarios/*.json
engine/data/scenarios/player_roles/*.json

# Exception: not in Supabase, so git remains its only copy.
!engine/data/scenarios/test_pipeline_01.json

# Version snapshots written at runtime by VersionController.saveVersion (one
# v<n>_<label>.json per apply/pipeline step). Each embeds a full copy of a
# scenario — the same content already excluded above — and Supabase holds the
# real lineage in scenario_versions, with base_version. Directory exclude: the
# dirs are created on demand per scenario, so a glob would miss new ones.
engine/data/scenarios/versions/
